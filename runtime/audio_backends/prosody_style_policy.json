  "backend_mappings": {
    "elevenlabs_existing_provider": {
      "runtime_status": "future_mapping_only",
      "allowed_now": false,
      "mapping_strategy": [
        "Do not insert Fish-style inline tags into ElevenLabs text.",
        "Future adapter may map backend-neutral pace/warmth/confidence/energy to provider voice settings only after provider support is verified.",
        "Fallback may use punctuation and text shaping only after a validator proves buyer-facing text is unchanged or intentionally approved."
      ],
      "blocked": [
        "[pause]",
        "[emphasis]",
        "[calm]",
        "[whispering]",
        "[reassuring]"
      ]
    },
    "kokoro_82m": {
      "runtime_status": "future_benchmark_mapping_only",
      "allowed_now": false,
      "mapping_strategy": [
        "Map pace to Kokoro speed if benchmark phase verifies the supported API.",
        "Map voice to a benchmark voice choice only inside ignored local audio artifacts.",
        "Use punctuation/text shaping fallback only in benchmark copies, never current live responses."
      ]
    },
    "fish_audio_s2_inspired": {
      "runtime_status": "inspiration_only_not_active_runtime",
      "allowed_now": false,
      "source_urls": [
        "https://fish.audio/s2/",
        "https://github.com/fishaudio/fish-speech",
        "https://huggingface.co/fishaudio/s2-pro",
        "https://speech.fish.audio/"
      ],
      "inline_tag_examples": [
        "[pause]",
        "[emphasis]",
        "[calm]",
        "[whispering]",
        "[reassuring]",
        "[laughing]",
        "[slow]",
        "[excited]"
      ],
      "mapping_strategy": [
        "Use Fish tags only as vocabulary inspiration for internal policy labels.",
        "Never leak bracketed tags into unsupported provider text.",
        "Validate rendered text for unsupported backends before any live TTS path can consume the policy."
      ]
    },
    "liquid_audio_lfm25": {
      "runtime_status": "future_speech_to_speech_style_hints_only",
      "allowed_now": false,
      "mapping_strategy": [
        "Future S2S adapter may translate the prosody object into speech-to-speech prompt/style hints.",
        "Verifier, campaign facts, source grounding, memory, and sales action selection remain project-owned.",
        "No partial generated audio may be played before verifier gating is designed and tested."
      ]
    }
  }
